APP_ENV=development
LOG_LEVEL=info

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

DATABASE_URL=postgres://app:secret@localhost:5433/appdb?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=2m
DB_PING_TIMEOUT=5s

JWT_SECRET=change-me-to-a-32+-char-secret-please
JWT_ACCESS_TTL=15m
JWT_ISSUER=day26-auth
REFRESH_TTL=720h

APP_ENV=development
LOG_LEVEL=info

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

DATABASE_URL=postgres://app:secret@localhost:5433/appdb?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=2m
DB_PING_TIMEOUT=5s

JWT_SECRET=change-me-to-a-32+-char-secret-please
JWT_ACCESS_TTL=15m
JWT_ISSUER=day30-auth
REFRESH_TTL=720h

RATE_LIMIT_GLOBAL_RPS=10
RATE_LIMIT_GLOBAL_BURST=30
RATE_LIMIT_AUTH_RPS=1
RATE_LIMIT_AUTH_BURST=5
RATE_LIMIT_TTL=5m

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID
CORS_EXPOSED_HEADERS=X-Request-ID,X-RateLimit-Limit,X-RateLimit-Remaining
CORS_MAX_AGE=5m
CORS_ALLOW_CREDENTIALS=true

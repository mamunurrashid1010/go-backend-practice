# Day 13 — environment template.
#
# Copy to .env, fill in real values. The .env file is gitignored
# (see the repo-root .gitignore); .env.example is committed.

# ---- App ---------------------------------------------------------
# development | staging | production
APP_ENV=development

# ---- HTTP server ------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# ---- Postgres ---------------------------------------------------
# REQUIRED. Host port 5433 matches Day 8's docker-compose mapping.
DATABASE_URL=postgres://app:app@localhost:5433/appdb?sslmode=disable

# Connection pool tuning.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=2m
DB_PING_TIMEOUT=5s

# Day 10 — environment template.
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env       # bash/zsh
#   Copy-Item .env.example .env  # PowerShell
#
# The .env file is gitignored (see the repo-root .gitignore). NEVER commit
# real secrets.

# Postgres connection string used by golang-migrate and (later) the API.
# Host port 5433 matches Day 8's docker-compose port mapping.
DATABASE_URL=postgres://app:app@localhost:5433/appdb?sslmode=disable
